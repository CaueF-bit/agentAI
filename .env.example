# Copie para .env.local e ajuste. NUNCA versione .env.local.
# Todos os valores abaixo são exemplos fictícios.

# Modo de demonstração: habilita login com personas fictícias e o pagamento simulado.
# Em produção deve ser "false" (e a autenticação real ainda precisa ser implementada).
DEMO_MODE=true

# Postgres gerenciado (ex.: Neon via Marketplace da Vercel, que preenche esta variável sozinho).
# Vazio = usa o banco embutido local (PGlite). Na Vercel é obrigatório.
DATABASE_URL=

# Onde o banco embutido (PGlite) grava os dados locais. Fica fora do Git (.data/).
PGLITE_DATA_DIR=.data/pglite

# Chave de 32 bytes em base64 para cifrar credenciais de integrações (AES-256-GCM).
# Gere com: node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
# Sem ela, em modo demo, uma chave temporária é gerada a cada inicialização (credenciais se perdem ao reiniciar).
CREDENTIALS_ENCRYPTION_KEY=
CREDENTIALS_KEY_ID=local-dev-1

# Segredo do webhook do provedor de pagamento SIMULADO (modo teste).
# Sem valor, em modo demo, um segredo temporário é gerado a cada inicialização.
TESTPAY_WEBHOOK_SECRET=

# Provedor de IA: "mock" (padrão, determinístico) ou "anthropic" (requer credencial e orçamento AUTORIZADOS).
AI_PROVIDER=mock
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-opus-5-5
